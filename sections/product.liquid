{
  "name": "Product Template",
  "settings": [],
  "blocks": [
    {
        "type": "sku",
        "name": "SKU",
        "limit": 1
    },
    {
        "type": "title",
        "name": "Title",
        "limit": 1
    },
    {
        "type": "vendor",
        "name": "vendor",
        "limit": 1
    },
    {
        "type": "price",
        "name": "Price",
        "limit": 1
    },
    {
        "type": "description",
        "name": "Description",
        "limit": 1
    },
    {
        "type": "quntity",
        "name": "Quntity",
        "limit": 1
    },
    {
        "type": "variants",
        "name": "Variants",
        "limit": 1
    },
    {
        "type": "add_to_cart_btn",
        "name": "Add to Cart Button",
        "limit": 1
    },
    {
        "type": "liquid",
        "name": "Liquid Code",
        "settings": [
            {
                "type": "liquid",
                "id": "liquid",
                "label": "Liquid Code"
            }
        ]
    }
  ],
  "default": {
    "blocks": [
        {
            "type": "sku"
        },
        {
            "type": "title"
        },
        {
            "type": "vendor"
        },
        {
            "type": "price"
        },
        {
            "type": "description"
        },
        {
            "type": "variants"
        },
        {
            "type": "quntity"
        },
        {
            "type": "add_to_cart_btn"
        }
    ]
   }
}
{% endschema %}

