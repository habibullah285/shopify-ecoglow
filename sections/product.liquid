{% assign product_form_id = 'product-form-' | append: section.id %}
<div class="product-section">
    <div class="container mx-auto py-10 px-4 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
            <div class="flex flex-col items-center gap-4">
                <div class="product-main-slider swiper w-full">
                      <div class="swiper-wrapper">
                          {% for media in product.media %}
                          <div class="swiper-slide">
                              {{ media | image_url: width: 600 | image_tag:
                                  class: "w-full object-cover rounded"
                              }}
                          </div>
                          {% endfor %}
                      </div>
                </div>
                {% if product.media.size > 1 %}
                    <div class="product-thumb-slider swiper w-full">
                        <div class="swiper-wrapper">
                            {% for media in product.media %}
                            <div class="swiper-slide p-1">
                                {{ media | image_url: width: 200 | image_tag:
                                    class: "w-full h-32 object-cover rounded cursor-pointer opacity-40"
                                }}
                            </div>
                            {% endfor %}
                        </div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                    </div>
                {% endif %}
                
            </div>

            <!-- RIGHT SIDE — PRODUCT INFO -->
            <div>
                <!-- Breadcrumb -->
                <p class="text-gray-500 text-sm mb-2">
                    <a href="{{ routes.root_url }}" class="hover:underline">Home</a>
                    
                    {% if product.collections.size > 0 %}
                        {% assign first_collection = product.collections.first %}
                        / <a href="{{ first_collection.url }}" class="hover:underline">{{ first_collection.title }}</a>
                    {% endif %}
                    
                    / <span class="text-black">{{ product.title }}</span>
                </p>
                {% form 'product', product, id: product_form_id %}
                    {% assign current_variant = product.selected_or_first_available_variant %}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {% for block in section.blocks %}
                        {%  case block.type %}
                            {%  when 'sku' %}
                                <p class="text-sm text-gray-500 mb-4">SKU: {{ product.selected_or_first_available_variant.sku }}</p>
                            {%  when 'vendor' %}
                                <p class="text-sm text-gray-500 mb-4">Vendor: {{ product.vendor }}</p>
                            {%  when 'title' %}
                                <h1 class="text-2xl font-semibold mb-2">{{ product.title | escape }}</h1>
                            
                            {%  when 'price' %}
                                <p id="product_price" class="text-xl font-semibold py-4">
                                    {{ current_variant.price | money_with_currency }}
                                </p>
                                
                            {%  when 'description' %}
                                <div class="text-gray-600 leading-relaxed text-sm my-4">
                                    {{ product.description }}
                                </div>
                            {% when 'liquid' %}
                                {{ block.settings.liquid }}
                            {%  when 'quntity' %}
                                <div class="flex items-center gap-4 mb-6">
                                    <button class="px-3 py-1 border">-</button>
                                    <span class="px-4">1</span>
                                    <button class="px-3 py-1 border">+</button>
                                </div>
                            {%  when 'variants' %}
                                {% unless product.has_only_default_variant %}
                                <div class="product-variants mb-4" id="productVariants">
                                    {% for option in product.options_with_values %}
                                        {% liquid
                                            assign variants_available_arr = product.variants | map: 'available'
                                            assign variants_option1_arr = product.variants | map: 'option1'
                                            assign variants_option2_arr = product.variants | map: 'option2'
                                            assign variants_option3_arr = product.variants | map: 'option3'
                                        %}
                                        <div class="option {{ option.name | downcase }} mb-4">
                                            <h6 class="font-semibold mb-2">{{ option.name }}</h6>
                                            <div class="flex flex-wrap gap-2">
                                            {% for value in option.values %}
                                                {% liquid
                                                assign option_disable = true
                                                for option1_name in variants_option1_arr
                                                    case option.position
                                                        when 1
                                                        if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                                        assign option_disable = false
                                                        endif
                                                        when 2
                                                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] ==  value and variants_available_arr[forloop.index0]
                                                        assign option_disable = false
                                                        endif
                                                        when 3
                                                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] ==  product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                                        assign option_disable = false
                                                        endif   
                                                    endcase
                                                endfor
                                                %}
                                                <label class="cursor-pointer radio">
                                                <input 
                                                    type="radio" 
                                                    name="{{ option.name | downcase | handle }}" 
                                                    value="{{ value | downcase | escape }}" 
                                                    class="sr-only peer" 
                                                    {% if option.selected_value == value %} checked {% endif %}
                                                    {% if option_disable %} disabled {% endif %}
                                                />
                                                <span class="px-4 py-2 border rounded-md text-sm font-medium bg-white border-gray-300 text-gray-900 peer-disabled:opacity-5 peer-checked:bg-gray-900 peer-checked:text-white transition" {% if option_disable %} title="Unavailable" {% endif %}>
                                                    {{ value | escape }}
                                                </span>
                                                </label>
                                            {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                {% endunless %}
                                <div>
                                <select name="id" id="variant_selector" class="hidden w-100 px-2 py-2 border-2 border-gray-900 my-3">
                                    {%  for variant in product.variants %}
                                        <option
                                            value="{{ variant.id }}"
                                            data-name="{{ variant.title | handleize | escape }}"
                                            data-price="{{ variant.price }}"
                                            data-money="{{ variant.price | money_with_currency }}"
                                            {% if variant == current_variant %} selected="selected" {% endif %}
                                            {% if variant.available == false %} data-sold="true" {% endif %}
                                            >
                                                {{ variant.title }} - {{ variant.price | money }}
                                        </option>
                                    {% endfor %} 
                                </select>
                                </div>
                            {%  when 'add_to_cart_btn' %}
                                {% assign variant = product.selected_or_first_available_variant %}
                                {% if variant and variant.available %}
                                    <button name="add" class="add-to-cart-btn cursor-pointer bg-black text-white px-6 py-3"
                                            data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                                            ADD TO CART
                                    </button>
                                {% else %}
                                     <button  class="cursor-pointer bg-black text-white px-6 py-3">Sold Out</button>
                                {% endif %}
                               

                        {% endcase %}
                    {% endfor %}
                {% endform %}

            </div>
        </div>

        <!-- TABS -->
        <div class="mt-14 border-t pt-8">
            <div class="flex gap-10 border-b pb-3 mb-6" id="dynamic-tabs-buttons">
                {% assign tab_index = 1 %}

                {% if product.description != blank %}
                <button class="tab-btn font-semibold border-b-2 border-black" data-tab="tab-{{ tab_index }}">DETAILS</button>
                {% assign tab_index = tab_index | plus: 1 %}
                {% endif %}

                {% if product.reviews != blank %}
                <button class="tab-btn {% if tab_index != 1 %}text-gray-600{% endif %}" data-tab="tab-{{ tab_index }}">REVIEW</button>
                {% assign tab_index = tab_index | plus: 1 %}
                {% endif %}

                {% if product.shipping_policy != blank %}
                <button class="tab-btn {% if tab_index != 1 %}text-gray-600{% endif %}" data-tab="tab-{{ tab_index }}">SHIPPING</button>
                {% assign tab_index = tab_index | plus: 1 %}
                {% endif %}

                {% if product.metafields.custom.wash_instructions != blank %}
                <button class="tab-btn {% if tab_index != 1 %}text-gray-600{% endif %}" data-tab="tab-{{ tab_index }}">WASH INSTRUCTIONS</button>
                {% assign tab_index = tab_index | plus: 1 %}
                {% endif %}
            </div>

            <div id="dynamic-tabs-contents">
                {% assign tab_index = 1 %}

                {% if product.description != blank %}
                <div id="tab-{{ tab_index }}" class="tab-content">
                    <p class="text-gray-600 leading-relaxed text-sm">{{ product.description }}</p>
                </div>
                {% assign tab_index = tab_index | plus: 1 %}
                {% endif %}

                {% if product.reviews != blank %}
                <div id="tab-{{ tab_index }}" class="tab-content hidden">
                    <p class="text-gray-600 leading-relaxed text-sm">{{ product.reviews }}</p>
                </div>
                {% assign tab_index = tab_index | plus: 1 %}
                {% endif %}

                {% if product.shipping_policy != blank %}
                <div id="tab-{{ tab_index }}" class="tab-content hidden">
                    <p class="text-gray-600 leading-relaxed text-sm">{{ product.shipping_policy }}</p>
                </div>
                {% assign tab_index = tab_index | plus: 1 %}
                {% endif %}

                {% if product.metafields.custom.wash_instructions != blank %}
                <div id="tab-{{ tab_index }}" class="tab-content hidden">
                    <p class="text-gray-600 leading-relaxed text-sm">{{ product.metafields.custom.wash_instructions }}</p>
                </div>
                {% assign tab_index = tab_index | plus: 1 %}
                {% endif %}
            </div>
            </div>
    </div>
</div>

<script>
{% comment %} window.addEventListener('DOMContentLoaded', async () => {
    const product_url = '{{ product.url }}'
    const variantSelector = async () => {
        const options = document.querySelectorAll("#productVariants .option");
        let optionValueArr = [];

        options.forEach(elm => {
            const checked = elm.querySelector('input:checked');
            if (checked) optionValueArr.push(checked.value);
        });

        const optionValue = optionValueArr.join('-');

        const variantOptions = document.querySelectorAll('#variant_selector option');
        const addBtn = document.querySelector('[name="add"]');
        const priceElm = document.getElementById("product_price");

        variantOptions.forEach(opt => {
            const name = opt.dataset.name;
            const sold = opt.dataset.sold === "true";

            const newPrice = opt.textContent.split(" - ").pop().trim();
            console.log(newPrice);
            priceElm.textContent = newPrice;

            if (name === optionValue) {
                opt.selected = true;

                if (sold) {
                    addBtn.disabled = true;
                    addBtn.innerText = "Sold Out";
                } else {
                    addBtn.disabled = false;
                    addBtn.innerText = "ADD TO CART";
                }

            } else {
                opt.selected = false;
            }
        });
    };

    // page load init
    await variantSelector();

    // radio button click listener
    const optionSelectors = document.querySelectorAll('#productVariants label.radio');
    optionSelectors.forEach(elm => {
        elm.addEventListener('click', async () => {
            variantSelector().then(()=> {
                const variantSelect = document.querySelector("#variant_selector");
                const selectedVariantId = variantSelect.value;
                // make sure product_url is defined
                const url = `${product_url}?variant=${selectedVariantId}`;
                window.history.replaceState({}, '', url);
            });
        });
    });

}); {% endcomment %}
document.addEventListener("DOMContentLoaded", () => {
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabContents = document.querySelectorAll(".tab-content");

    tabButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            const target = btn.dataset.tab;

            // Hide all contents
            tabContents.forEach(c => c.classList.add("hidden"));

            // Remove active styles from all buttons
            tabButtons.forEach(b => {
                b.classList.remove("border-b-2", "border-black", "font-semibold");
                b.classList.add("text-gray-600");
            });

            // Show target content
            document.getElementById(target).classList.remove("hidden");

            // Add active style to clicked tab
            btn.classList.add("border-b-2", "border-black", "font-semibold");
            btn.classList.remove("text-gray-600");
        });
    });
});

document.addEventListener("DOMContentLoaded", () => {

    const priceElm = document.getElementById("product_price");
    const variantSelect = document.getElementById("variant_selector");
    const addBtn = document.querySelector('[name="add"]');
    const product_url = "{{ product.url }}";

    function updateVariant() {
        const selected = variantSelect.options[variantSelect.selectedIndex];
        if (!selected) return;

        // update price
        priceElm.textContent = selected.dataset.money;

        // button state
        if (selected.dataset.sold === "true") {
            addBtn.disabled = true;
            addBtn.innerText = "Sold Out";
        } else {
            addBtn.disabled = false;
            addBtn.innerText = "ADD TO CART";
        }

        // update URL
        const variantId = selected.value;
        history.replaceState({}, "", `${product_url}?variant=${variantId}`);
    }

    // init
    updateVariant();

    // select change event
    variantSelect.addEventListener("change", updateVariant);

    // radio button click → sync to dropdown
    document.querySelectorAll('#productVariants input[type="radio"]').forEach((radio) => {
        radio.addEventListener("change", () => {
            const selectedOptions = [...document.querySelectorAll('#productVariants input:checked')].map(el => el.value.toLowerCase());
            const matchKey = selectedOptions.join("-");

            [...variantSelect.options].forEach(opt => {
                if (opt.dataset.name === matchKey) {
                    opt.selected = true;
                }
            });

            updateVariant();
        });
    });
});

</script>




