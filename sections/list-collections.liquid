<div class="w-full  my-20">
    <div class="container mx-auto px-4">
         <!-- Header -->
        <div class="header mb-10 text-center">
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900">
                {{ page_title }}
            </h2>
            <p class="mt-2 text-gray-600 text-sm md:text-base">
                Shop by your favorite styles and categories.
            </p>
        </div>
        <!-- Collections Grid -->
        <div class="w-full main-collections">
            <div class="grid grid-cols-12 gap-6">
                {% for collection in collections %}
                    {% unless collection.handle contains 'frontpage' %}
                        <div class="col-span-6 md:col-span-4 lg:col-span-3">
                            <a href="{{ collection.url }}" class="block group">
                                <div class="bg-white shadow-md rounded-xl overflow-hidden transition transform group-hover:-translate-y-1 group-hover:shadow-xl">
                                    <!-- Image -->
                                    <div class="w-full overflow-hidden">
                                        {{ collection.featured_image 
                                            | image_url: width: 360 
                                            | image_tag: class: 'h-70 w-90 object-cover rounded-t-xl'
                                        }}
                                    </div>

                                    <!-- Title + Description -->
                                    <div class="p-4 text-center">
                                        <h3 class="text-lg font-semibold group-hover:text-blue-600 transition">
                                            {{ collection.title | escape | link_to: collection.url  }}
                                        </h3>
                                        {% if collection.description != blank %}
                                            <p class="mt-2 text-gray-600 text-sm">
                                                {{ collection.description }}
                                            </p>
                                        {% endif %}
                                    </div>

                                </div>
                            </a>
                        </div>
                    {% endunless %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
