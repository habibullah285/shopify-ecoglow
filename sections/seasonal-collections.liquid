<section class="w-full bg-white my-15">
  <div class="container mx-auto px-4 grid grid-cols-1 lg:grid-cols-2">
    
    <!-- LEFT TEXT AREA -->
    <div class="bg-black text-white flex flex-col justify-center px-8 lg:px-16 py-16">
      <h1 class="text-4xl lg:text-5xl font-semibold leading-tight mb-6">
        {{ section.settings.title }}
      </h1>

      <p class="text-gray-300 max-w-md mb-8">
        {{ section.settings.description }}
      </p>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_url }}"
          class="inline-block border border-white px-8 py-3 uppercase text-sm tracking-wide max-w-[180px] text-center">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <!-- RIGHT IMAGES GRID -->
    <div class="grid grid-cols-2 grid-rows-2 gap-1 pl-1">

      {% for i in (1..4) %}
        {% assign img = 'image_' | append: i %}
        <div class="h-56 sm:h-72 md:h-80 lg:h-full">
          {% if section.settings[img] %}
                {{
                    section.settings[img]
                    | image_url: width: 400, height: 400
                    | image_tag: 
                        width: 400,
                        height: 400,
                        class: 'object-cover w-full h-full',
                        alt: 'Gallery Image'
                }}
            {% endif %}
        </div>
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Seasonal Collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Discover Our Exclusive Seasonal Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handpicked Seasonal essentials crafted for comfort and style. Explore our latest arrivals and elevate your seasonal wardrobe."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "default": "/collections/all"
    },

    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" }
  ],
  "presets": [
    {
      "name": "Seasonal Collections"
    }
  ]
}
{% endschema %}
