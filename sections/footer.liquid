{% liquid
  assign footer_logo = section.settings.footer_logo
  assign block_count = section.blocks.size
%}

<footer class="site-footer bg-gray-900">
  <div class="px-4 pt-16 pb-6 mx-auto sm:px-6 lg:px-8 lg:pt-24">
    
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
      
      <!-- LEFT: Logo & Description -->
      <div class="md:col-span-1">
        <div class="flex justify-start">
          {% if footer_logo %}
            <a href="{{ routes.root_url }}">
              {{ footer_logo | image_url: width: 150 | image_tag: class: "footer-logo", alt: shop.name }}
            </a>
          {% else %}
            <a href="{{ routes.root_url }}">
              <h1 class="text-xl font-bold text-white">{{ shop.name }}</h1>
            </a>
          {% endif %}
        </div>

        <p class="max-w-md mt-6 leading-relaxed text-gray-400">
          {{ section.settings.footer_text }}
        </p>

        {% if section.settings.footer_social_media %}
          <div class="mt-6 flex gap-4">
            {% render 'social-icons' %}
          </div>
        {% endif %}

        {% if section.settings.show_payment_icons %}
          <div class="footer-payment flex items-center gap-3 mt-6 opacity-80">
            {% for type in shop.enabled_payment_types %}
              {{ type | payment_type_svg_tag }}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- RIGHT: Blocks (Menu / Info / Image) -->
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 md:grid-cols-{{ block_count }} md:col-span-2">
        {% for block in section.blocks %}
          <div>
            {% case block.type %}
              {% when 'menu' %}
                <h3 class="text-lg font-medium text-white">{{ block.settings.menu_title }}</h3>
                <ul class="mt-4 space-y-3 text-sm">
                  {% for link in block.settings.footer_menu.links %}
                    <li><a class="text-white hover:text-white/70" href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>

              {% when 'info' %}
                <h3 class="text-lg font-medium text-white">{{ block.settings.info_title }}</h3>
                <div class="footer-info text-white">
                  {{ block.settings.info }}
                </div>

              {% when 'image' %}
                {% if block.settings.url %}
                  <a href="{{ block.settings.url }}">
                    {{ block.settings.image | image_url: width: 150 | image_tag: class: "footer-logo h-auto w-auto", alt: shop.name }}
                  </a>
                {% else %}
                  {{ block.settings.image | image_url: width: 150 | image_tag: class: "footer-logo h-auto w-auto", alt: shop.name }}
                {% endif %}
            {% endcase %}
          </div>
        {% endfor %}
      </div>

    </div>

    <!-- COPYRIGHT -->
    <div class="pt-6 mt-12 border-t border-gray-800">
      <p class="text-sm text-gray-500 text-center">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer Description",
      "default": "Browse our latest products and get exciting deals every day."
    },
    {
      "type": "checkbox",
      "id": "footer_social_media",
      "label": "Show Social Media Icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Footer Menu",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Menu Title",
          "default": "Menu Title"
        },
        {
          "type": "link_list",
          "id": "footer_menu",
          "label": "Footer menu"
        }
      ]
    },
    {
      "type": "info",
      "name": "Info",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "info_title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "richtext",
          "id": "info",
          "label": "Info"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
