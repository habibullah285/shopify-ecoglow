<section class="w-full my-5 bg-[#D2D5DF]">
  <div class="container mx-auto flex flex-col md:flex-row items-center">
    <div class="md:w-1/2 mb-8 md:mb-0 px-20 pt-5 pb-5">
      <div class="max-w-[440px]">
          <h1 class="text-[68px] leading-[72px] pb-6">{{ section.settings.title }}</h1>
          <p class="text-[20px] leading-[30px] pb-8">{{ section.settings.description }}</p>
          {% if section.settings.button_link != blank %}
            <a href="{{ section.settings.button_link }}" class="bg-black text-white px-12 py-3 inline-block">
              {{ section.settings.button_text }}
            </a>
          {% endif %}
      </div>
    </div>

    <!-- Image -->
    <div class="md:w-1/2 flex justify-center">
      {% if section.settings.banner_image != blank %}
        {{ section.settings.banner_image
            | image_url: width: 900
            | image_tag: 
              class: 'w-full h-full object-cover -mt-[30px] z-[1]', 
              alt: section.settings.title 
        }}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner: New Arrival",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "New Arrival"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Egestas quam arcu convallis ipsum iaculis neque. Volutpat venenatis tincidunt non fermentum a velit mai soli ta haiplu out."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    }
  ]
}
{% endschema %}
