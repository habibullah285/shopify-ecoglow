<section class="w-full py-16 my-10">
  <div class="container mx-auto px-4">
    <div class="w-full text-center">
      <h2 class="text-4xl font-semibold mb-2">
        {{ section.settings.heading }}
      </h2>

      <p class="text-gray-500">
        {{ section.settings.subheading }}
      </p>
    </div>

    {% assign all_collections = section.blocks %}
    {% assign block_count = all_collections | size %}

    <div class="collection-tab-slider">
      {% if block_count > 1 %}
        <div class="mt-6 flex justify-center gap-6">
          {% for block in all_collections %}
            {% assign col = block.settings.collection %}
            <button class="tab-btn cursor-pointer pb-1 {% if forloop.first %}text-black font-medium border-b-2 border-black{% else %}text-gray-500{% endif %}" 
                    data-tab="tab-{{ block.id }}">
              {{ col.title }}
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Swipers -->
      <div class="relative mt-12">
        {% for block in all_collections %}
          {% assign col = block.settings.collection %}

          <div id="tab-{{ block.id }}" 
              class="swiper site-swiper {% if block_count > 1 %}{% unless forloop.first %}!hidden{% endunless %}{% endif %}">
              
            <div class="swiper-wrapper">
              {% for product in col.products limit: section.settings.products_to_show %}
                <div class="swiper-slide">
                  {%- render 'new-product-card', product:product -%}
                </div>
              {% endfor %}
            </div>
            <div class="swiper-button-prev !w-[30px] !h-[30px] bg-white p-[5px] rounded-full text-black"></div>
            <div class="swiper-button-next !w-[30px] !h-[30px] bg-white p-[5px] rounded-full text-black"></div>

            <a href="{{ col.url }}" class="block mt-10 bg-black text-white px-8 py-3 w-fit mx-auto">
              View All Products
            </a>

          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Latest Collections Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our top picks for you."
    },
    {
      "type": "number",
      "id": "products_to_show",
      "label": "How many products to show?",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Item",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Latest Collections Slider"
    }
  ]
}
{% endschema %}
