<!-- Overlay -->
<div id="cart-overlay" class="fixed inset-0 bg-black bg-opacity-50 hidden z-40" style="background-color: #0000007d;"></div>

<!-- Drawer -->
<div id="cart-drawer" class="fixed top-0 right-0 w-80 max-w-full h-full bg-white shadow-xl transform translate-x-full transition-transform duration-300 z-50 overflow-y-auto">
    <div class="p-4 border-b flex justify-between items-center">
        <h2 class="text-lg font-semibold">Your Cart</h2>
        <button id="cart-close" class="bg-gray-900 text-white text-xl cursor-pointer px-3 py-1 rounded">&times;</button>
    </div>

    <div id="cart-items" class="p-4 space-y-4">
        <!-- JS দিয়ে এখানে cart items load হবে -->
        <p class="text-gray-400">Loading...</p>
    </div>

    <div class="p-4 border-t">
        <a href="{{ routes.cart_url }}" class="block bg-gray-900 text-white text-center py-2 rounded hover:bg-gray-800">View Cart / Checkout</a>
    </div>
</div>