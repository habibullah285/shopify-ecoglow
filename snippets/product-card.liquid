<div class="max-w-full bg-white shadow-md rounded-xl duration-500 hover:scale-105 hover:shadow-xl">
    <!-- Image -->
    <div class="w-full overflow-hidden">
        {{ product.featured_image 
            | image_url: width: 360 
            | image_tag: class: 'h-60 object-cover rounded-t-xl'
        }}
    </div>

    <!-- Title + Price -->
    <div class="px-4 py-3">
        <span class="text-gray-400 mr-3 uppercase text-xs">{{ product.vendor }}</span>
        <h3 class="text-lg font-semibold group-hover:text-blue-600 transition">
            <a href="{{ product.url }}">{{  product.title }}</a>
        </h3>
        <div class="flex items-center">
            <p class="text-lg font-semibold text-black cursor-auto my-3">{{ product.price | money }}</p>
            {% if product.compare_at_price > product.price %}
            <del>
                <p class="text-sm text-gray-600 cursor-auto ml-2">{{ product.compare_at_price | money }}</p>
            </del>
            {% endif %}
            <div class="ml-auto">
            {% render 'icon-shoping-bag' %}
            </div>
        </div>
    </div>
</div>