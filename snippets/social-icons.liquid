{% if settings.show_social_media %}
<div class="flex gap-4">
  {% if settings.facebook_url != blank %}
    <a href="{{ settings.facebook_url }}" target="_blank" rel="noopener">
      <img src="{{ 'facebook-icon.svg' | asset_url }}" alt="Facebook" class="w-6 h-6">
    </a>
  {% endif %}
  {% if settings.twitter_url != blank %}
    <a href="{{ settings.twitter_url }}" target="_blank" rel="noopener">
      <img src="{{ 'twitter-icon.svg' | asset_url }}" alt="Twitter" class="w-6 h-6">
    </a>
  {% endif %}
  {% if settings.instagram_url != blank %}
    <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">
      <img src="{{ 'instagram-icon.svg' | asset_url }}" alt="Instagram" class="w-6 h-6">
    </a>
  {% endif %}
  {% if settings.linkedin_url != blank %}
    <a href="{{ settings.linkedin_url }}" target="_blank" rel="noopener">
      <img src="{{ 'linkedin-icon.svg' | asset_url }}" alt="LinkedIn" class="w-6 h-6">
    </a>
  {% endif %}
</div>
{% endif %}
