<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="description" content="{{ page_description | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    {{ content_for_header }}
    {{ 'output.css' | asset_url | stylesheet_tag }}
    {% comment %} {{ 'swiper.min.css' | asset_url | stylesheet_tag }}
    {{ 'swiper-bundle.min.js' | asset_url | script_tag }} {% endcomment %}
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"/>
     <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
  </head>
  <body>
    {% section 'header' %}
    <main role="main" >
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}

    {%- comment -%} Custom JS file (deferred) {%- endcomment -%}
    <script src="{{ 'output.js' | asset_url }}" defer></script>
  </body>
</html>